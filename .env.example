# Plantilla de variables de entorno de IntelliAgent.
# Copie este archivo a .env y reemplace los valores ficticios. Nunca suba .env a git.

# Clave interna de la API. El backend exige que exista al arrancar.
API_KEY=cambie-esta-clave

# Conexión a PostgreSQL. Con Docker Compose el host es db_service y el puerto 5432.
# Sin Docker use localhost:5433. Cambie usuario, contraseña y base por los suyos.
DATABASE_URL=postgresql+psycopg://usuario:contrasena@db_service:5432/nombre_bd

# Modelo de lenguaje (endpoint compatible con OpenAI).
OPENAI_API_KEY=sk-ejemplo-no-es-real
OPENAI_MODEL_NAME=gpt-4o-mini
# Opcional: déjela vacía para usar el endpoint oficial de OpenAI.
OPENAI_BASE_URL=

# Correo (SMTP de salida e IMAP de entrada). Para Gmail use una contraseña de aplicación.
EMAIL_ADDRESS=usuario@example.com
EMAIL_PASSWORD=contrasena-de-aplicacion-ejemplo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465

# Trello (solo si usa la creación de tarjetas).
TRELLO_API_KEY=clave-trello-ejemplo
TRELLO_API_TOKEN=token-trello-ejemplo
# Lista por defecto cuando la petición no trae trello_list_id.
TRELLO_DEFAULT_LIST_ID=lista-ejemplo

# Nombre del proyecto que muestra GET / (Compose lo fija a IntelliAgent).
MY_PROJECT=IntelliAgent

# Frontend (solo en desarrollo con Vite). Por defecto el frontend usa /api.
VITE_API_URL=/api
